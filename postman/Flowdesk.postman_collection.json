{
  "info": {
    "_postman_id": "76f2ab19-61e8-4bb2-8654-2f0e2a85b1b5",
    "name": "Flowdesk API",
    "description": "Collection de demonstração da API Flowdesk. Execute as requisições na ordem apresentada para criar e atender um chamado completo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "admin_email", "value": "admin@admin.com" },
    { "key": "agent_email", "value": "agent@agent.com" },
    { "key": "requester_email", "value": "requester@requester.com" },
    { "key": "default_password", "value": "abcd1234" },
    { "key": "admin_token", "value": "" },
    { "key": "agent_token", "value": "" },
    { "key": "requester_token", "value": "" },
    { "key": "requester_id", "value": "" },
    { "key": "agent_id", "value": "" },
    { "key": "team_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "ticket_id", "value": "" },
    { "key": "notification_id", "value": "" },
    { "key": "reverb_app_key", "value": "", "description": "Copie o valor de REVERB_APP_KEY do arquivo .env." },
    { "key": "socket_id", "value": "", "description": "Copie o socket_id recebido ao conectar no WebSocket." },
    { "key": "reverb_auth", "value": "", "description": "Preenchido pela requisição de autorização do canal privado." }
  ],
  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
              "name": "Login - Admin",
              "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Login do admin retornou 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json().data;",
              "pm.collectionVariables.set('admin_token', body.token);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{default_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
            "name": "Login - Agente",
            "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Login do agente retornou 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json().data;",
              "pm.collectionVariables.set('agent_token', body.token);",
              "pm.collectionVariables.set('agent_id', body.user.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{agent_email}}\",\n  \"password\": \"{{default_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
            "name": "Login - Solicitante",
            "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Login do solicitante retornou 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json().data;",
              "pm.collectionVariables.set('requester_token', body.token);",
              "pm.collectionVariables.set('requester_id', body.user.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{requester_email}}\",\n  \"password\": \"{{default_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Perfil do usuário autenticado",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "02 - Equipe e categoria de teste",
      "item": [
        {
          "name": "Admin",
          "item": [
            {
          "name": "Criar equipe",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Equipe criada', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('team_id', pm.response.json().data.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Equipe de teste {{$randomUUID}}\",\n  \"description\": \"Equipe criada pela collection Postman.\"\n}" },
            "url": "{{base_url}}/api/v1/teams"
          }
        },
        {
          "name": "Vincular agente à equipe",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Agente vinculado', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"agent_ids\": [\"{{agent_id}}\"]\n}" },
            "url": "{{base_url}}/api/v1/teams/{{team_id}}/agents"
          }
        },
        {
          "name": "Criar categoria",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Categoria criada', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('category_id', pm.response.json().data.id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"team_id\": \"{{team_id}}\",\n  \"name\": \"Categoria de teste {{$randomUUID}}\",\n  \"description\": \"Categoria criada pela collection Postman.\"\n}" },
            "url": "{{base_url}}/api/v1/teams/categories"
          }
        },
        {
          "name": "Listar equipes",
          "description": "Disponível somente para administradores.",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/v1/teams"
          }
        }
          ]
        },
        {
          "name": "Listar categorias",
          "description": "Disponível para qualquer usuário autenticado.",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "url": "{{base_url}}/api/v1/teams/categories"
          }
        }
      ]
    },
    {
      "name": "03 - Chamado e atendimento",
      "item": [
        {
          "name": "Solicitante",
          "item": [
            { "name": "Criar ticket", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Ticket criado', () => pm.response.to.have.status(201));", "const ticket = pm.response.json().data;", "pm.collectionVariables.set('ticket_id', ticket.id);", "pm.test('Ticket foi direcionado para a equipe criada', () => pm.expect(ticket.team.id).to.eql(pm.collectionVariables.get('team_id')));"] } }], "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Falha de teste {{$randomUUID}}\",\n  \"description\": \"Ticket de demonstração criado pela collection Postman.\",\n  \"category_id\": \"{{category_id}}\",\n  \"priority\": \"high\"\n}" }, "url": "{{base_url}}/api/v1/tickets" } },
            { "name": "Listar os próprios tickets", "description": "Retorna apenas os tickets criados pelo solicitante autenticado.", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Solicitante listou seus tickets', () => pm.response.to.have.status(200));", "const tickets = pm.response.json().data;", "pm.test('Não há ticket de outro solicitante na resposta', () => pm.expect(tickets.every(ticket => ticket.requester_id === pm.collectionVariables.get('requester_id'))).to.be.true);"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }], "url": "{{base_url}}/api/v1/tickets" } },
            { "name": "Consultar o próprio ticket", "description": "A resposta inclui o campo ai quando a análise assíncrona for concluída. Aguarde ai.status=published antes de solicitar atendimento humano.", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Solicitante consultou o próprio ticket', () => pm.response.to.have.status(200));", "pm.test('Ticket consultado é o ticket criado', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('ticket_id')));"] } }], "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }], "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}" } },
            { "name": "Solicitar ajuda humana", "description": "Use após a IA publicar uma orientação. Inicia o SLA e notifica todos os agentes da equipe responsável uma única vez.", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Solicitação de ajuda humana registrada', () => pm.response.to.have.status(200));", "const ticket = pm.response.json().data;", "pm.test('SLA foi iniciado', () => pm.expect(ticket.sla.first_response_due_at).to.not.eql(null));", "pm.test('Pedido de ajuda humana foi registrado', () => pm.expect(ticket.human_assistance_requested_at).to.not.eql(null));"] } }], "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }], "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/request-human-assistance" } },
            { "name": "Adicionar comentário no próprio ticket", "description": "O solicitante pode comentar somente no ticket que abriu.", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Comentário do solicitante criado', () => pm.response.to.have.status(201));", "pm.test('Autor é o solicitante', () => pm.expect(pm.response.json().data.source).to.eql('requester'));"] } }], "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"body\": \"A orientação não resolveu o problema.\"\n}" }, "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/comments" } }
          ]
        },
        {
          "name": "Agente",
          "item": [
            { "name": "Listar tickets da própria equipe", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }], "url": "{{base_url}}/api/v1/tickets?status=open" } },
            { "name": "Consultar ticket", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }], "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}" } },
            { "name": "Assumir ticket", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Ticket assumido', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }], "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/assume" } },
            { "name": "Adicionar comentário", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Comentário criado', () => pm.response.to.have.status(201));"] } }], "request": { "method": "POST", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"body\": \"Atendimento iniciado pelo agente de teste.\"\n}" }, "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/comments" } },
            { "name": "Resolver ticket", "request": { "method": "PATCH", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"resolved\"\n}" }, "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/status" } },
            { "name": "Fechar ticket", "request": { "method": "PATCH", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"closed\"\n}" }, "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/status" } }
          ]
        },
        {
          "name": "Admin",
          "item": [{ "name": "Listar todos os tickets", "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/api/v1/tickets" } }]
        }
      ]
    },
    {
      "name": "04 - Notificações",
      "item": [
        {
          "name": "Listar notificações do usuário autenticado",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Notificações listadas', () => pm.response.to.have.status(200));",
              "const notification = pm.response.json().data[0];",
              "if (notification) pm.collectionVariables.set('notification_id', notification.id);"
            ] }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "url": "{{base_url}}/api/v1/notifications"
          }
        },
        {
          "name": "Marcar notificação como lida",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "url": "{{base_url}}/api/v1/notifications/{{notification_id}}/read"
          }
        }
      ]
    },
    {
      "name": "05 - Preparação WebSocket (Reverb)",
      "description": "O Postman não permite misturar requisições HTTP e WebSocket na mesma collection; por isso, crie a conexão WebSocket manualmente em New > WebSocket. Use: ws://localhost:8080/app/{{reverb_app_key}}?protocol=7&client=postman&version=1.0&flash=false. Copie o data.socket_id da primeira mensagem recebida para a variável socket_id e, então, execute a autorização abaixo. O auth é vinculado ao socket_id: sempre que desconectar ou reconectar, repita a autorização antes de enviar a inscrição.",
      "item": [
        {
          "name": "Autorizar canal privado do usuário autenticado",
          "description": "Crie antes uma conexão nativa em New > WebSocket e conecte em ws://localhost:8080/app/{{reverb_app_key}}?protocol=7&client=postman&version=1.0&flash=false. Copie o data.socket_id para a variável socket_id e execute esta requisição. O auth vale somente para esse socket_id. Em seguida, envie na conexão WebSocket:\n\n{\n  \"event\": \"pusher:subscribe\",\n  \"data\": {\n    \"channel\": \"private-App.Models.User.{{requester_id}}\",\n    \"auth\": \"{{reverb_auth}}\"\n  }\n}\n\nA confirmação esperada é pusher_internal:subscription_succeeded.",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Canal privado autorizado', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('reverb_auth', pm.response.json().auth);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "socket_id", "value": "{{socket_id}}", "type": "text" },
                { "key": "channel_name", "value": "private-App.Models.User.{{requester_id}}", "type": "text" }
              ]
            },
            "url": "{{base_url}}/api/broadcasting/auth"
          }
        }
      ]
    },
    {
      "name": "06 - Encerrar sessões",
      "item": [
        {
          "name": "Logout com token de solicitante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Logout com token de agente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        },
        {
          "name": "Logout com token de admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/v1/auth/logout"
          }
        }
      ]
    }
  ]
}
